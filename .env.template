# Conexión del backend a la base de datos (Supabase/PostgreSQL).
# Copia este archivo a .env y reemplaza [YOUR-PASSWORD] por la contraseña de la base de datos
# (Supabase Dashboard > Project Settings > Database > Connection string).

# Conexión directa (IPv6, útil para servidores de larga duración)
DATABASE_URI=postgresql://postgres:[YOUR-PASSWORD]@db.wugxkiytgjlticzyxxem.supabase.co:5432/postgres

# Alternativa vía connection pooler (Transaction mode, recomendado para serverless/edge):
# DATABASE_URI=postgresql://postgres.wugxkiytgjlticzyxxem:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres
