# Copia este archivo a .env.local (en este mismo directorio, apps/api/) y completa los valores.

# URL del proyecto Supabase.
SUPABASE_URL=https://wugxkiytgjlticzyxxem.supabase.co

# Service role key (Supabase Dashboard > Project Settings > API > service_role).
# NUNCA exponer esta key al cliente: solo se usa en src/lib/supabase.ts, server-side.
SUPABASE_SERVICE_ROLE_KEY=

# Secreto para firmar los JWT emitidos por /auth/register y /auth/login.
# Generar uno largo y aleatorio, p. ej.: openssl rand -base64 48
JWT_SECRET=
